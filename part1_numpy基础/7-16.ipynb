     "text": [
      "[[ 5  8]\n",
      " [10 14]]\n",
      "[[ 4  7]\n",
      " [10 15]]\n",
      "5.000000000000001\n",
      "[[ 0.6 -0.2]\n",
      " [-0.2  0.4]]\n",
      "解x =  [1.8 1.4]\n"
     ]
    }
   ],
   "source": [
    "import numpy as np\n",
    "A =np.array([[2,1],[1,3]])\n",
    "B= np.array([[1,2],[3,4]])\n",
    "print(A @ B)\n",
    "print(B @ A)\n",
    "det_A = np.linalg.det(A)\n",
    "inv_A = np.linalg.inv(A)\n",
    "print(det_A)\n",
    "print(inv_A)\n",
    "b = np.array([5,6])\n",
    "x = inv_A @ b\n",
    "print('解x = ',x)"
   ]
  }
 ],
